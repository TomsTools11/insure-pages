  description="We build websites for independent insurance agents. Live in five days, starting at $499. You own the site and the domain."
>
  <Header />
  <main id="main">
    <Hero />
    <TrustStrip />
    <Pillars />
    <Method />
    <Pricing />
    <ContactCta />
