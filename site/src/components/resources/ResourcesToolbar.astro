---
import { toolCount, categoryCount } from "../../data/resources.mjs";
---

{/* Every control here needs the script in ResourcesList.astro, so without
    JavaScript the whole bar is hidden rather than shipped dead. A <noscript>
    style, not a hidden attribute the script removes, so a visitor with
    JavaScript never sees the bar pop in after first paint. */}
<noscript>
  <style>
    .r-toolbar {
      display: none;
    }
  </style>
</noscript>
<div class="r-toolbar" data-res-toolbar>
  <div class="container r-toolbar-inner">
    <div class="r-search">
      <svg
        class="r-search-glyph"
        viewBox="0 0 20 20"
        width="16"
        height="16"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="2.4" />
        <path d="M13 13l5 5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
      </svg>
      <label class="sr-only" for="res-q">Search the resource list</label>
      <input
        id="res-q"
        class="r-search-input"
        type="search"
        placeholder={`Search ${Math.floor(toolCount / 100) * 100}+ tools`}
        autocomplete="off"
        data-res-q
      />
      <button type="button" class="r-clear" data-res-clear>Clear</button>
    </div>
    <p class="r-result" role="status" data-res-label>
      {toolCount} tools, {categoryCount} categories
    </p>
    <div class="r-toolbar-actions">
      <button type="button" class="r-action" data-res-expand>Expand all</button>
      <button type="button" class="r-action" data-res-collapse>Collapse all</button>
    </div>
  </div>
</div>

<style>
  /* Sticks under the site header, so the offset is the header's height:
     20px padding either side of the 205px-wide logo (81px tall at its
     655x259 ratio) plus the 2px border, 123px. At 480px the header narrows
     the logo to 152px (60px tall), 102px. Change one, change the other. */
  .r-toolbar {
    --tb-top: 123px;
    position: sticky;
    top: var(--tb-top);
    z-index: 90;
    background: var(--cream);
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 16px 0;
  }
  .r-toolbar-inner {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .r-search {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 100px;
    box-shadow: 3px 3px 0 var(--ink);
    padding: 0 8px 0 18px;
    flex: 1 1 320px;
    min-width: 0;
  }
  .r-search:focus-within {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .r-search-glyph {
    flex: none;
    color: var(--muted);
  }
  .r-search-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    padding: 14px 0;
  }
  /* The wrapper draws the focus ring, so the input's own would double it. */
  .r-search-input:focus-visible {
    outline: 0;
  }
  .r-search-input::-webkit-search-cancel-button {
    display: none;
  }
  .r-clear {
    flex: none;
    border: 2px solid var(--ink);
    background: var(--cream-deep);
    border-radius: 100px;
    padding: 6px 14px;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
  }
  .r-clear:hover {
    background: var(--yellow);
  }
  .r-result {
    font-size: 14px;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
  }
  .r-toolbar-actions {
    display: flex;
    gap: 10px;
    margin-left: auto;
  }
  .r-action {
    border: 2px solid var(--ink);
    background: #fff;
    border-radius: 100px;
    box-shadow: 3px 3px 0 var(--ink);
    padding: 10px 18px;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .r-action:hover {
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 600px) {
    .r-toolbar-actions {
      margin-left: 0;
    }
  }
  @media (max-width: 480px) {
    .r-toolbar {
      --tb-top: 102px;
    }
  }
</style>
