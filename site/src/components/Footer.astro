---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        {/* On-ink variant of the same lockup: the master art's #1a1a1a
            outline/shadow disappears against this footer, and its #2c5972
            "by … labs" sits at 2.3:1. Recolored to the two on-dark values
            this footer already uses (--yellow, #8fc7ff). */}
        <img
          class="footer-logo"
          src="/images/insurepages-logo-dark.png"
          alt="InsurePages"
          width="655"
          height="259"
          loading="lazy"
          decoding="async"
        />
        <p class="footer-tag">
          Websites for independent insurance agents. Built in five days, yours
          to keep.
        </p>
        <div class="footer-house">InsurePages by S3 Labs</div>
        {/* An icon-only link has no text, so each anchor carries the
            accessible name and each <svg> is aria-hidden: the glyph must not
            be announced on top of it. */}
        <ul class="footer-social">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`InsurePages on ${social.name}`}
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="20"
                    height="20"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path fill="currentColor" d={social.path} />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <nav aria-label="Site">
        <h2 class="footer-col-title">Site</h2>
        <div class="footer-col-list">
          <a href="/#build">Approach</a>
          <a href="/#method">Method</a>
          <a href="/templates/">Templates</a>
          <a href="/#pricing">Packages</a>
          <a href="/#contact">Contact</a>
        </div>
      </nav>
      <nav aria-label="Resources">
        <h2 class="footer-col-title">Resources</h2>
        <div class="footer-col-list">
          <a href="/accessibility/">Accessibility</a>
        </div>
      </nav>
      {/* The badge shares this grid cell with the Hello column but sits
          outside the <nav>: a directory badge is not site navigation, and
          folding it into the nav's link list would announce it as one. */}
      <div class="footer-hello">
        <nav aria-label="Get in touch">
          <h2 class="footer-col-title">Hello</h2>
          <div class="footer-col-list">
            <a href="/#contact">Contact us</a>
            <a href="https://formrobin.com/f/344no93" target="_blank" rel="noopener"
              >Schedule a call</a
            >
          </div>
        </nav>
        {/* Startup Fame directory badge. Self-hosted rather than hot-linked
            from startupfa.me (same as the fonts and logos) so the footer costs
            no third-party request; the dofollow link back is what the
            directory verifies, and that is preserved. */}
        <a
          class="footer-badge"
          href="https://startupfa.me/s/insurepages?utm_source=insurepages.com"
          target="_blank"
          rel="noopener"
        >
          <img
            src="/images/startup-fame-badge.webp"
            alt="Featured on Startup Fame"
            width="468"
            height="148"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>
    <div class="footer-bar">
      <span>© 2026 InsurePages · by S3 Labs</span>
      <span>Made with care in the studio.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #fff;
    padding: 80px 0 24px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 56px;
    padding-bottom: 56px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
  }
  .footer-logo {
    display: block;
    width: 250px;
    max-width: 100%;
    height: auto;
    margin-bottom: 24px;
  }
  .footer-tag {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    max-width: 280px;
    line-height: 1.6;
    margin-bottom: 16px;
  }
  .footer-house {
    font-size: 12px;
    color: #8fc7ff; /* was #2e9df180 in prototype, which fails contrast on ink */
    font-weight: 600;
  }
  /* Social row. 42px tiles clear the 24x24 minimum target size (WCAG 2.5.8)
     with room to spare, and the four of them plus gaps come to 198px, inside
     the 240px a 320px viewport leaves after the container's side padding, so
     the row never forces the footer grid wider than the screen. */
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin-top: 20px;
  }
  .footer-social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.35);
    transition: transform 0.15s ease, color 0.15s ease, background 0.15s ease,
      border-color 0.15s ease;
  }
  .footer-social a:hover {
    color: var(--ink);
    background: var(--yellow);
    border-color: var(--yellow);
    transform: translate(-1px, -1px);
  }
  .footer-social a:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }
  .footer-social svg { display: block; }
  .footer-badge {
    display: inline-block;
    margin-top: 24px;
    border-radius: 10px;
  }
  .footer-badge img {
    display: block;
    width: 171px;
    height: auto;
  }
  .footer-badge:focus-visible {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }
  .footer-col-title {
    font-family: "Unbounded", sans-serif;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--yellow);
    margin-bottom: 20px;
    font-weight: 700;
  }
  .footer-col-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .footer-col-list a {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }
  .footer-col-list a:hover { color: var(--yellow); }
  .footer-bar {
    padding-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.62);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  /* Verification fix (Task 8): at narrow phone widths the 2-column grid's
     implicit auto-minimum track size (driven by the unbreakable "InsurePages"
     brand mark) forced the grid wider than the viewport, causing horizontal
     scroll. Stack to one column and shrink the logo so it never has to.
     200px clears the 240px content box a 320px viewport leaves after the
     container's 40px side padding. */
  @media (max-width: 560px) {
    .footer-top { grid-template-columns: 1fr; gap: 40px; }
    .footer-logo { width: 200px; }
  }
</style>
