---
import { templates } from "../../data/templates.mjs";
import { demoExists, thumbIsLocal, thumbSrc, THUMB_W, THUMB_H } from "../../data/template-assets.mjs";

const t = [templates.find((x) => x.featured), templates[0]].find(
  (x) => x && thumbIsLocal(x.slug),
);
const live = t && demoExists(t.slug);
---

{
  t && (
    <section class="feat">
      <div class="container feat-inner">
        <div class="feat-media" data-reveal>
          <div class="feat-shot">
            <div class="feat-bar">{t.domain}</div>
            <img
              src={thumbSrc(t.slug)}
              alt={`Large screenshot of the ${t.name} template homepage`}
              width={THUMB_W}
              height={THUMB_H}
              loading="lazy"
              decoding="async"
            />
          </div>
          <span class="feat-note note-1">Quote button always in reach ✦</span>
          <span class="feat-note note-2">Reads clearly on any phone ★</span>
        </div>
        <div class="feat-copy" data-reveal style="--ri: 1">
          <h2>Meet {t.name}, the one we'd start with.</h2>
          <p class="feat-body">
            Big confident headlines, your history up top, and a quote button
            people never lose sight of. Built for agencies with deep roots and
            busy phones.
          </p>
          {live && (
            <a
              class="btn btn-ink"
              href={`/demos/${t.slug}/`}
              target="_blank"
              rel="noopener"
            >
              Preview site
              <span class="sr-only">
                : the {t.name} template (opens in a new tab)
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .feat {
    background: #fff;
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    padding: 110px 0;
    overflow: hidden;
  }
  .feat-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 72px;
    align-items: center;
  }
  .feat-media {
    position: relative;
    padding: 24px 12px;
  }
  .feat-shot {
    border: 2px solid var(--ink);
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    box-shadow: 8px 8px 0 var(--red);
    transform: rotate(-2deg);
  }
  .feat-bar {
    background: var(--cream-deep);
    border-bottom: 2px solid var(--ink);
    padding: 9px 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }
  .feat-shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .feat-note {
    position: absolute;
    background: var(--yellow);
    border: 2px solid var(--ink);
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 700;
    font-size: 13px;
    box-shadow: 3px 3px 0 var(--ink);
    white-space: nowrap;
  }
  /* Notes sit on the section margin, straddling the frame's edge, so the
     screenshot itself stays unobstructed. */
  .note-1 {
    top: 0;
    left: -8px;
    transform: rotate(-3deg);
  }
  .note-2 {
    bottom: 2px;
    right: -6px;
    transform: rotate(2deg);
  }
  .feat-copy h2 {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 44px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: 22px;
  }
  .feat-body {
    font-size: 17px;
    line-height: 1.6;
    font-weight: 500;
    color: #3a3a3a;
    margin-bottom: 34px;
    max-width: 44ch;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 900px) {
    .feat { padding: 72px 0; }
    .feat-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .feat-media { padding: 20px 0 28px; }
    .note-1 { left: 0; }
    .note-2 { right: 0; }
  }
</style>
