---
import { demoExists, thumbSrc, THUMB_W, THUMB_H } from "../../data/template-assets.mjs";

interface Props {
  t: {
    slug: string;
    name: string;
    domain: string;
    tagline: string;
    tags: string[];
    accent: string;
    size: string;
  };
  index: number;
}
const { t, index } = Astro.props;
const live = demoExists(t.slug);
---

<article
  class={`t-card t-${t.size} accent-${t.accent}`}
  data-reveal
  style={`--ri: ${index}`}
>
  <div class="t-frame">
    <div class="t-bar">{t.domain}</div>
    <img
      src={thumbSrc(t.slug)}
      alt={`Screenshot of the ${t.name} template homepage`}
      width={THUMB_W}
      height={THUMB_H}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="t-meta">
    <div class="t-title-row">
      <h3 class="t-name">{t.name}</h3>
      <div class="t-tags">
        {t.tags.map((tag) => <span class="t-tag">{tag}</span>)}
      </div>
    </div>
    <p class="t-tagline">{t.tagline}</p>
    {
      live ? (
        <a
          class="btn btn-yellow t-btn"
          href={`/demos/${t.slug}/`}
          target="_blank"
          rel="noopener"
        >
          Preview site
          <span class="sr-only">
            : the {t.name} template (opens in a new tab)
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      ) : (
        <span class="t-soon">Demo landing soon</span>
      )
    }
  </div>
</article>

<style>
  .t-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
    transition: all 0.2s ease;
  }
  .t-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 9px 9px 0 var(--ink);
  }
  .t-wide { grid-column: span 2; }
  .t-tall { grid-row: span 2; }
  .t-frame {
    border-bottom: 2px solid var(--ink);
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .t-bar {
    padding: 8px 16px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    border-bottom: 2px solid var(--ink);
  }
  /* Ink on red: 5.6:1, white on red would fail AA at this size. */
  .accent-red .t-bar { background: var(--red); }
  .accent-yellow .t-bar { background: var(--yellow); }
  .accent-green .t-bar { background: var(--green); }
  .accent-blue .t-bar { background: var(--blue); }
  .accent-lavender .t-bar { background: var(--lavender); }
  .t-frame img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-grow: 1;
    object-fit: cover;
    object-position: top center;
  }
  .t-meta {
    padding: 24px 26px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .t-title-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .t-name {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .t-tags {
    display: flex;
    gap: 8px;
  }
  .t-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 2px solid var(--ink);
    border-radius: 100px;
    background: var(--cream);
  }
  .t-tagline {
    font-size: 15px;
    font-weight: 500;
    color: #3a3a3a;
    max-width: 40ch;
  }
  .t-btn {
    padding: 13px 24px;
    font-size: 14px;
    margin-top: 6px;
  }
  .t-soon {
    display: inline-flex;
    align-items: center;
    padding: 13px 24px;
    margin-top: 6px;
    border: 2px dashed var(--ink);
    border-radius: 100px;
    font-weight: 700;
    font-size: 14px;
    color: var(--muted);
    background: var(--cream);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 900px) {
    .t-wide { grid-column: auto; }
    .t-tall { grid-row: auto; }
    .t-frame img {
      height: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>
