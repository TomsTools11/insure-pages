---
const days = [
  {
    n: "Day 1",
    title: "Pick your template",
    body: "Choose the design that fits your agency's personality.",
  },
  {
    n: "Day 2",
    title: "Brand it yours",
    body: "We swap in your name, colors, photos, and services.",
  },
  {
    n: "Day 3",
    title: "Draft your pages",
    body: "Clear words for every policy you offer, reviewed by you.",
  },
  {
    n: "Day 4",
    title: "One round of polish",
    body: "Mark up anything you want changed and we refine it.",
  },
  {
    n: "Day 5",
    title: "Go live",
    body: "Your site launches, tested and ready for customers.",
  },
];
---

<section class="path">
  <div class="container">
    <div class="section-head">
      <span class="section-eyebrow" style="background: var(--green);"
        >The turnaround</span
      >
      <h2 class="section-title">From template to yours in five days.</h2>
    </div>
    <ol class="path-track">
      {
        days.map((d, i) => (
          <li class="path-stop" data-reveal style={`--ri: ${i}`}>
            <span class="path-day">{d.n}</span>
            <h3 class="path-title">{d.title}</h3>
            <p class="path-body">{d.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="path-more">
      Curious how we keep that pace? <a href="/#method">See the full method</a>
    </p>
  </div>
</section>

<style>
  .path {
    padding: 110px 0;
  }
  .path-track {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 26px;
    position: relative;
    padding-top: 14px;
  }
  /* The dashed route the five stops sit on. */
  .path-track::before {
    content: "";
    position: absolute;
    top: 32px;
    left: 4%;
    right: 4%;
    border-top: 3px dashed var(--ink);
    opacity: 0.35;
  }
  .path-stop {
    position: relative;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 16px;
    padding: 22px 20px;
    box-shadow: 4px 4px 0 var(--ink);
  }
  .path-stop:nth-child(odd) { transform: rotate(-0.6deg); }
  .path-stop:nth-child(even) { transform: rotate(0.6deg); }
  .path-day {
    display: inline-block;
    background: var(--green);
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 4px 10px;
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: 12px;
    box-shadow: 3px 3px 0 var(--ink);
    margin-bottom: 16px;
  }
  .path-title {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }
  .path-body {
    font-size: 14px;
    line-height: 1.5;
    font-weight: 500;
    color: #3a3a3a;
  }
  .path-more {
    text-align: center;
    margin-top: 48px;
    font-weight: 600;
    font-size: 16px;
  }
  .path-more a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .path-more a:hover { text-decoration-color: var(--green); }
  @media (max-width: 900px) {
    .path { padding: 72px 0; }
    .path-track {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .path-track::before {
      top: 8px;
      bottom: 8px;
      left: 26px;
      right: auto;
      border-top: none;
      border-left: 3px dashed var(--ink);
    }
    .path-stop:nth-child(odd),
    .path-stop:nth-child(even) { transform: none; }
  }
</style>
