---
import { templates } from "../../data/templates.mjs";
import { thumbSrc, THUMB_W, THUMB_H } from "../../data/template-assets.mjs";

// The fan is a decorative teaser of the gallery below; three is plenty.
const fan = templates.slice(0, 3);
---

<section class="g-hero">
  <div class="container g-hero-inner">
    <div class="g-hero-copy">
      <h1>Pick a look you love. We make it yours.</h1>
      <p class="g-hero-lede">
        Six complete websites built for insurance agencies. Pick one and it
        goes live under your name in a couple weeks.
      </p>
      <div class="g-hero-cta">
        <a href="#gallery" class="btn btn-ink">See all six ↓</a>
        <a
          href="https://formrobin.com/f/344no93"
          target="_blank"
          rel="noopener"
          class="btn btn-light"
          >Schedule a call</a
        >
      </div>
    </div>
    <div class="g-hero-fan" aria-hidden="true">
      {
        fan.map((t, i) => (
          <div class={`fan-frame fan-${i}`}>
            <div class="fan-bar">{t.domain}</div>
            <img
              src={thumbSrc(t.slug)}
              alt=""
              width={THUMB_W}
              height={THUMB_H}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .g-hero {
    padding: 72px 0 88px;
    overflow: hidden;
  }
  .g-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 56px;
    align-items: center;
  }
  h1 {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: clamp(34px, 3.7vw, 52px);
    line-height: 1.04;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
  }
  .g-hero-lede {
    font-size: 19px;
    line-height: 1.55;
    color: #3a3a3a;
    font-weight: 500;
    max-width: 480px;
    margin-bottom: 40px;
  }
  .g-hero-cta {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
  }
  .g-hero-fan {
    position: relative;
    min-height: 460px;
  }
  .fan-frame {
    position: absolute;
    width: 72%;
    background: #fff;
    border: 2px solid var(--ink);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 6px 6px 0 var(--ink);
  }
  .fan-bar {
    background: var(--cream-deep);
    border-bottom: 2px solid var(--ink);
    padding: 8px 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--muted);
  }
  .fan-frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .fan-0 {
    top: 6%;
    left: 0;
    transform: rotate(-4deg);
    z-index: 3;
  }
  .fan-1 {
    top: 0;
    right: 0;
    transform: rotate(3deg);
    z-index: 2;
  }
  .fan-2 {
    bottom: 0;
    left: 16%;
    transform: rotate(-1deg);
    z-index: 1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .fan-0 { animation: fan-float 7s ease-in-out infinite; }
    .fan-1 { animation: fan-float 8s ease-in-out 0.8s infinite; }
    @keyframes fan-float {
      0%, 100% { translate: 0 0; }
      50% { translate: 0 -10px; }
    }
  }
  @media (max-width: 900px) {
    .g-hero { padding: 44px 0 56px; }
    .g-hero-inner {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .g-hero-lede { max-width: none; }
    .g-hero-fan { min-height: 340px; }
  }
</style>
