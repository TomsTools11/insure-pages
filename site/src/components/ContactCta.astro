<section class="cta-band" id="contact">
  <span class="cta-deco cta-deco-1" aria-hidden="true">Free consult ✦</span>
  <span class="cta-deco cta-deco-2" aria-hidden="true">No contracts ★</span>
  <span class="cta-deco cta-deco-3" aria-hidden="true"></span>
  <span class="cta-deco cta-deco-4" aria-hidden="true"></span>
  <div class="container">
    <h2>Ready to look as good as you are?</h2>
    <p class="cta-lede">
      A conversation costs nothing. Pick whichever way you'd rather start.
    </p>

    <div class="paths">
      <div class="path-card">
        <span class="path-tag tag-form">60 seconds</span>
        <h3 class="path-title">Tell us about your project</h3>
        <p class="path-copy">
          A few quick questions — your agency, the lines you write, what the
          site has to do. We come back with a plan and a price.
        </p>
        <a
          href="https://share.kiwiform.com/to/ofwodo6p"
          target="_blank"
          rel="noopener"
          class="btn btn-ink path-btn"
          data-kiwi-trigger
          >Get Started Now →</a
        >
        <!-- The embed builds its own trigger button. It stays hidden and the
             card's button forwards the click, so the card keeps the site's own
             markup and still reaches the form as a plain link when the embed
             is blocked or JavaScript is off. -->
        <div
          class="kiwi-embed"
          data-kiwiform-live="cmtd4evv70ap0dqpgd3y66f2w"
          hidden
        >
        </div>
      </div>

      <div class="path-card">
        <span class="path-tag tag-call">30 minutes</span>
        <h3 class="path-title">Rather talk it through?</h3>
        <p class="path-copy">
          Book a call and we'll look at your current site, what your agency
          writes, and what it would take to fix it.
        </p>
        <a
          href="https://formrobin.com/f/344no93"
          target="_blank"
          rel="noopener"
          class="btn btn-yellow path-btn"
          >Schedule a call →</a
        >
      </div>
    </div>

    <p class="cta-reassure">
      Straight answer either way — we'll tell you if we're not the right fit.
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    var ORIGIN = "https://share.kiwiform.com";
    var host = document.querySelector("[data-kiwiform-live]");
    var trigger = document.querySelector("[data-kiwi-trigger]");
    var loaded = false;

    function loadEmbed() {
      if (loaded) return;
      loaded = true;
      var s = document.createElement("script");
      s.src = ORIGIN + "/embed.js";
      s.async = true;
      document.body.appendChild(s);
    }

    /* Open the popup from the card's own button. Until embed.js has built its
       hidden trigger the click falls through to the href, which is the same
       form on its own page. */
    if (host && trigger) {
      trigger.addEventListener("click", function (e) {
        var embedBtn = host.querySelector("button");
        if (!embedBtn) return;
        e.preventDefault();
        trigger.focus({ preventScroll: true });
        embedBtn.click();
      });
    }

    /* The popup the embed appends to <body> ships without dialog semantics, a
       labelled close control, a titled iframe, or Escape-to-dismiss, so add
       them as it appears. */
    var behind = [];
    var dialog = null;
    var opener = null;

    function isEmbedOverlay(node) {
      if (!node || node.nodeType !== 1 || node.tagName !== "DIV") return false;
      var frame = node.querySelector("iframe");
      return !!frame && frame.src.indexOf(ORIGIN) === 0;
    }

    function onKeydown(e) {
      if (e.key !== "Escape" || !dialog) return;
      var close = dialog.querySelector("button");
      if (close) close.click();
      else if (dialog.parentNode) dialog.parentNode.removeChild(dialog);
    }

    function openDialog(overlay) {
      dialog = overlay;
      opener = document.activeElement;
      var panel = overlay.firstElementChild || overlay;
      panel.setAttribute("role", "dialog");
      panel.setAttribute("aria-modal", "true");
      panel.setAttribute("aria-label", "Tell us about your project");
      panel.setAttribute("data-kiwi-dialog", "");
      var frame = overlay.querySelector("iframe");
      if (frame && !frame.title) frame.title = "InsurePages contact form";
      var close = panel.querySelector("button");
      if (close && !close.getAttribute("aria-label")) {
        close.setAttribute("aria-label", "Close the contact form");
      }
      /* Nothing behind the modal should take focus while it is open. */
      for (var el = document.body.firstElementChild; el; el = el.nextElementSibling) {
        if (el !== overlay && !el.hasAttribute("inert")) {
          el.setAttribute("inert", "");
          behind.push(el);
        }
      }
      document.addEventListener("keydown", onKeydown, true);
      if (close) close.focus({ preventScroll: true });
    }

    function closeDialog() {
      document.removeEventListener("keydown", onKeydown, true);
      for (var i = 0; i < behind.length; i++) behind[i].removeAttribute("inert");
      behind = [];
      dialog = null;
      if (opener && opener.isConnected) opener.focus({ preventScroll: true });
      opener = null;
    }

    new MutationObserver(function (records) {
      for (var i = 0; i < records.length; i++) {
        var added = records[i].addedNodes;
        for (var a = 0; a < added.length; a++) {
          if (!dialog && isEmbedOverlay(added[a])) openDialog(added[a]);
        }
        var gone = records[i].removedNodes;
        for (var r = 0; r < gone.length; r++) {
          if (gone[r] === dialog) closeDialog();
        }
      }
    }).observe(document.body, { childList: true });

    /* Load embed.js only as the band comes into view, so it stays off the
       critical path. */
    var band = document.getElementById("contact");
    if (!band || !("IntersectionObserver" in window)) {
      loadEmbed();
      return;
    }
    var io = new IntersectionObserver(
      function (entries) {
        if (entries.some(function (e) { return e.isIntersecting; })) {
          loadEmbed();
          io.disconnect();
        }
      },
      { rootMargin: "600px" }
    );
    io.observe(band);
  })();
</script>

<style>
  .cta-band {
    padding: 120px 0;
    background: var(--red);
    border-top: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-deco { position: absolute; pointer-events: none; }
  .cta-deco-1 {
    top: 40px; left: 80px;
    background: var(--yellow);
    border: 2px solid var(--ink);
    padding: 14px 20px;
    border-radius: 10px;
    font-weight: 700;
    transform: rotate(-12deg);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .cta-deco-2 {
    bottom: 60px; right: 100px;
    background: var(--blue);
    border: 2px solid var(--ink);
    padding: 14px 20px;
    border-radius: 10px;
    font-weight: 700;
    transform: rotate(8deg);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .cta-deco-3 {
    top: 80px; right: 140px;
    width: 72px; height: 72px;
    background: var(--green);
    border: 2px solid var(--ink);
    border-radius: 50%;
    box-shadow: 4px 4px 0 var(--ink);
    transform: rotate(-15deg);
  }
  .cta-deco-4 {
    bottom: 80px; left: 120px;
    width: 80px; height: 80px;
    background: var(--lavender);
    border: 2px solid var(--ink);
    border-radius: 16px;
    box-shadow: 4px 4px 0 var(--ink);
    transform: rotate(18deg);
  }
  h2 {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #fff;
    max-width: 900px;
    margin: 0 auto 24px;
    position: relative;
  }
  .cta-lede {
    position: relative;
    font-size: 19px;
    color: #fff;
    font-weight: 700; /* 19px bold clears the AA large-text threshold on red */
    max-width: 560px;
    margin: 0 auto 56px;
  }
  .paths {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
    max-width: 940px;
    margin: 0 auto;
    text-align: left;
  }
  .path-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--cream);
    border: 2px solid var(--ink);
    border-radius: 24px;
    box-shadow: 6px 6px 0 var(--ink);
    padding: 32px;
  }
  .path-tag {
    position: absolute;
    top: -14px;
    left: 24px;
    border: 2px solid var(--ink);
    border-radius: 8px;
    padding: 6px 14px;
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--ink);
  }
  .tag-form { background: var(--lavender); }
  .tag-call { background: var(--green); }
  .path-title {
    font-family: "Unbounded", sans-serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 10px 0 14px;
  }
  .path-copy {
    font-size: 16px;
    font-weight: 500;
    color: var(--muted);
    margin: 0 0 28px;
    text-wrap: pretty;
  }
  .path-btn { align-self: flex-start; margin-top: auto; }
  .kiwi-embed[hidden] { display: none; }
  .cta-reassure {
    position: relative;
    max-width: 600px;
    margin: 36px auto 0;
    font-size: 15px;
    font-weight: 700;
    /* The design sets this line in white. At 15px bold that is 3.1:1 on red,
       under the 4.5:1 AA needs below the large-text threshold, so it takes ink
       (5.5:1) and keeps the design's type scale. */
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .cta-band { padding: 72px 0; }
    .cta-deco { display: none; }
  }
</style>

<style is:global>
  /* Focus ring for the modal's close control, which sits on a dark scrim
     where the site's default ink outline would disappear. */
  [data-kiwi-dialog] button:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 2px;
  }
</style>
